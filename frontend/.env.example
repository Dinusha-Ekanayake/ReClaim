# Server-side Next.js rewrite target for same-origin browser requests to /api.
# Include the backend /api suffix; browser code never calls this origin directly.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Socket.io server URL (no /api suffix).
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Canonical public URL used for metadata and social sharing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
