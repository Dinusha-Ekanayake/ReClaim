// This is your Prisma schema file
// Learn more at: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum ItemType {
  LOST
  FOUND
}

enum ItemStatus {
  ACTIVE
  MATCHED
  CLAIM_PENDING
  RETURNED
  CLOSED
  REJECTED
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportReason {
  FAKE
  INAPPROPRIATE
  SPAM
  WRONG_CATEGORY
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  SPAM
}

enum NotificationType {
  MATCH_FOUND
  NEW_MESSAGE
  CLAIM_SUBMITTED
  CLAIM_APPROVED
  CLAIM_REJECTED
  ITEM_RETURNED
  COMMENT_ADDED
  SYSTEM
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  password       String
  name           String
  avatarUrl      String?
  avatarPublicId String?
  phone          String?
  showPhone      Boolean  @default(false)
  role           Role     @default(USER)
  isVerified     Boolean  @default(false)
  isBanned       Boolean  @default(false)
  banReason      String?
  bio            String?
  location       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  items               Item[]
  comments            Comment[]
  sentMessages        Message[]            @relation("SentMessages")
  chatParticipants    ChatParticipant[]
  claimsSubmitted     Claim[]              @relation("ClaimantUser")
  notifications       Notification[]
  reports             Report[]             @relation("ReporterUser")
  reportedItems       Report[]             @relation("ReportedItemOwner")
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  pendingUploads      PendingUpload[]

  @@index([email])
  @@index([role])
  @@index([createdAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model Item {
  id          String     @id @default(uuid())
  type        ItemType
  status      ItemStatus @default(ACTIVE)
  title       String
  description String
  category    String
  subcategory String?
  brand       String?
  color       String?
  size        String?

  // Location
  locationLabel String // e.g., "Near University of Colombo"
  locationLat   Float?
  locationLng   Float?
  locationArea  String? // approximate area for display

  // Dates
  dateLostFound DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  contentRevision Int      @default(1)
  deletedAt       DateTime?

  // Owner
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Images
  images ItemImage[]

  // Verification (for found items — hidden details to verify real owner)
  verificationHints String[] // stored as array, not shown publicly

  // Embedding for AI matching (stored as JSON array)
  embedding Json?

  // Durable matching work state. Matching is asynchronous, but unlike an
  // in-process promise this state survives deploys, crashes, and API restarts.
  matchingPending   Boolean   @default(false)
  matchingLockedAt  DateTime?
  matchingRetryAt   DateTime?
  matchingAttempts  Int       @default(0)
  matchingLastError String?

  // Contact option
  showContactInfo Boolean @default(false)

  // Moderation
  isApproved Boolean @default(false)
  adminNote  String?

  // Relations
  comments       Comment[]
  matchesAsLost  Match[]   @relation("LostItem")
  matchesAsFound Match[]   @relation("FoundItem")
  claims         Claim[]
  reports        Report[]
  chats          Chat[]

  @@index([type, status])
  @@index([isApproved, status, createdAt])
  @@index([type, status, isApproved, category, createdAt])
  @@index([matchingPending, isApproved, status, matchingRetryAt, createdAt])
  @@index([deletedAt, isApproved, status, createdAt])
  @@index([userId, status, createdAt])
  @@index([userId])
  @@index([category])
  @@index([createdAt])
}

model ItemImage {
  id        String   @id @default(uuid())
  url       String
  publicId  String   @unique // Cloudinary public ID for deletion
  isPrimary Boolean  @default(false)
  position  Int      @default(0)
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([itemId, position])
}

model PendingUpload {
  id               String    @id @default(uuid())
  userId           String?
  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  url              String?
  publicId         String    @unique
  expiresAt        DateTime
  cleanupClaimedAt DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt, cleanupClaimedAt])
}

model Match {
  id          String   @id @default(uuid())
  lostItemId  String
  foundItemId String
  score       Float // 0-100 matching score
  breakdown   Json // { category: 30, keywords: 25, location: 20, date: 15, image: 10 }
  lostRank    Int? // ranking assigned when the lost report is processed
  foundRank   Int? // ranking assigned when the found report is processed
  isNotified  Boolean  @default(false)
  createdAt   DateTime @default(now())

  lostItem  Item @relation("LostItem", fields: [lostItemId], references: [id], onDelete: Cascade)
  foundItem Item @relation("FoundItem", fields: [foundItemId], references: [id], onDelete: Cascade)

  @@unique([lostItemId, foundItemId])
  @@index([lostItemId])
  @@index([foundItemId])
  @@index([lostItemId, lostRank])
  @@index([foundItemId, foundRank])
  @@index([score])
}

model Claim {
  id                  String      @id @default(uuid())
  itemId              String
  claimantId          String
  status              ClaimStatus @default(PENDING)
  verificationAnswers Json // answers to hidden hints
  message             String? // message from claimant
  adminNote           String?
  reviewedAt          DateTime?
  reviewedBy          String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  item     Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  claimant User @relation("ClaimantUser", fields: [claimantId], references: [id], onDelete: Cascade)

  @@unique([itemId, claimantId])
  @@index([itemId])
  @@index([itemId, status, createdAt])
  @@index([claimantId])
  @@index([claimantId, createdAt])
  @@index([status])
}

model Chat {
  id        String   @id @default(uuid())
  itemId    String? // context item (optional)
  item      Item?   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ChatParticipant[]
  messages     Message[]

  @@index([itemId])
}

model ChatParticipant {
  id         String   @id @default(uuid())
  chatId     String
  userId     String
  lastReadAt DateTime @default(now())
  createdAt  DateTime @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([userId])
}

model Message {
  id        String   @id @default(uuid())
  chatId    String
  senderId  String
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([chatId, createdAt])
  @@index([chatId, isRead, senderId])
  @@index([senderId])
  @@index([createdAt])
}

model Comment {
  id        String   @id @default(uuid())
  itemId    String
  userId    String
  content   String
  parentId  String? // for nested replies
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item    Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  @@index([itemId])
  @@index([userId])
  @@index([itemId, parentId, isHidden, createdAt])
  @@index([parentId, isHidden, createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model Report {
  id          String       @id @default(uuid())
  itemId      String
  reporterId  String
  itemOwnerId String
  reason      ReportReason
  description String?
  status      ReportStatus @default(PENDING)
  adminNote   String?
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime     @default(now())

  item      Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  reporter  User @relation("ReporterUser", fields: [reporterId], references: [id], onDelete: Cascade)
  itemOwner User @relation("ReportedItemOwner", fields: [itemOwnerId], references: [id], onDelete: Cascade)

  @@unique([itemId, reporterId])
  @@index([itemId])
  @@index([reporterId])
  @@index([status, createdAt])
}

model ContactMessage {
  id         String        @id @default(uuid())
  name       String
  email      String
  subject    String
  message    String
  status     ContactStatus @default(NEW)
  adminNote  String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  resolvedAt DateTime?

  @@index([status, createdAt])
  @@index([email])
}
