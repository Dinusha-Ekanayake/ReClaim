# ─── Database (PostgreSQL — e.g. Supabase) ──────────────────────────────────
# Pooled connection used by the app at runtime.
DATABASE_URL=postgresql://user:password@host:5432/reclaim?pgbouncer=true
# A long-lived Express instance needs enough connections for concurrent list,
# count, readiness, matching-worker, and Socket.IO queries.
DATABASE_CONNECTION_LIMIT=5
DATABASE_POOL_TIMEOUT_SECONDS=30
# Migration connection used by Prisma CLI. Supabase's db.<ref> direct endpoint
# is IPv6-only on projects without the IPv4 add-on, while Render is IPv4-only.
# For Render + Supabase, use the Supavisor SESSION pooler on port 5432 here
# (not the transaction pooler on 6543). A true direct URL is fine on IPv6 hosts.
DIRECT_URL=postgresql://postgres.project-ref:password@aws-1-region.pooler.supabase.com:5432/postgres

# ─── Auth (JWT) ─────────────────────────────────────────────────────────────
# Use long, random, DISTINCT values in production (≥ 32 chars each).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-DIFFERENT-long-random-secret
UPLOAD_RECEIPT_SECRET=replace-with-a-THIRD-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Cloudinary (image uploads) ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── OpenAI (optional — enables AI embedding matching) ──────────────────────
# If omitted, matching gracefully falls back to keyword/attribute scoring.
OPENAI_API_KEY=
# Durable worker tuning (bounded in code: interval 5s-5m, batch 1-50).
MATCHING_WORKER_INTERVAL_MS=15000
MATCHING_WORKER_BATCH_SIZE=10

# ─── App ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (CORS).
FRONTEND_URL=http://localhost:3000
PORT=5000
NODE_ENV=development

# Required only when running `npm run seed`; set all values explicitly and
# never use shared or published credentials.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-a-unique-strong-password
ADMIN_NAME=Your Name

# Required in production for mandatory email verification and password-reset
# delivery (https://resend.com). Without a working provider, newly registered
# users cannot complete sign-in. EMAIL_FROM must be a verified sender/domain.
RESEND_API_KEY=
EMAIL_FROM=ReClaim <no-reply@your-domain.com>

# `ADMIN_PASSWORD` has no built-in default; keep every seed value private.
