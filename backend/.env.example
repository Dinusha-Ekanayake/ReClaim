# ─── Database (PostgreSQL — e.g. Supabase) ──────────────────────────────────
# Pooled connection used by the app at runtime.
DATABASE_URL=postgresql://user:password@host:5432/reclaim?pgbouncer=true
# Direct connection used by Prisma migrations (no pgbouncer).
DIRECT_URL=postgresql://user:password@host:5432/reclaim

# ─── Auth (JWT) ─────────────────────────────────────────────────────────────
# Use long, random, DISTINCT values in production (≥ 32 chars each).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-DIFFERENT-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Cloudinary (image uploads) ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── OpenAI (optional — enables AI embedding matching) ──────────────────────
# If omitted, matching gracefully falls back to keyword/attribute scoring.
OPENAI_API_KEY=

# ─── App ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (CORS).
FRONTEND_URL=http://localhost:3000
PORT=5000
NODE_ENV=development

# ─── Seed admin (optional overrides) ────────────────────────────────────────
ADMIN_EMAIL=admin@reclaim.app
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=ReClaim Admin
